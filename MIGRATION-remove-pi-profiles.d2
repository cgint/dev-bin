direction: down

stop: "**1. Stop Pi**\npgrep -x pi empty\n(herdr, hc)" {style.fill: "#fff3cd"}
pull: "**2. git pull**"
migrate: "**3. pi_profiles_migrate.sh --apply**" {
  style.fill: "#e6f4ea"
  merge: "merge all sessions\nremap fork links"
  swap: "swap sessions\narchive profiles"
  tidy: "retire 9 skills\nfix ACP map, .zshrc"
  merge -> swap -> tidy
}
deploy: "**4. agents_files_cp.sh --delete**\nAGENTS.md, skills, prompts" {style.fill: "#e8f0fe"}
verify: "**Verify**\n/resume across former profiles"
rollback: "~/.pi-rollback-YYYYMMDD" {style.fill: "#f8d7da"}

stop -> pull -> migrate -> deploy -> verify
migrate.swap -> rollback: "moved, not deleted" {style.stroke-dash: 3}
