direction: down

preflight: "1. Pre-flight & Stop Writers" {
  style.fill: "#FFF4E5"
  check: "Verify zero pi processes\n(check Herdr sessions & Docker)"
  pull: "Pull latest dev-bin\n(removes pi-profile)"
  check -> pull
}

stage: "2. Stage New ~/.pi/agent (Same Volume)" {
  style.fill: "#E8F4FD"
  copy: "Copy minimal/agent\n(excluding sessions/)"
  creds: "Replace auth.json & models.json\nsymlinks with 0600 regular copies"
  merge: "Merge all session roots\n+ remap parentSession fork links"
  copy -> creds -> merge
}

swap: "3. Atomic Swap & Rollout" {
  style.fill: "#E8F5E9"
  mv_old: "Move ~/.pi/{agent,profiles}\n-> ~/.pi-rollback-YYYYMMDD/"
  mv_new: "Move staged agent\n-> ~/.pi/agent"
  deploy: "Deploy generated configs\n(pi, claude, codex, gemini, copilot, cursor)"
  shell: "Clean ~/.zshrc / ~/.bashrc\n+ pull pi-subagent-herdr"
  mv_old -> mv_new -> deploy -> shell
}

verify: "4. Verify" {
  style.fill: "#F3E5F5"
  checks: "Zero broken symlinks · pi auth & models OK\nNo ~/.pi/profiles · No pi-profile on PATH"
}

preflight -> stage -> swap -> verify
