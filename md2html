#!/usr/bin/env bash
set -euo pipefail

OPEN_IN_BROWSER=false
VIEW_TEMP=false
INPUT_FILE=""
PREPASS_TMP=""

# Remove only the intermediate pre-pass file; the HTML output is never touched here.
cleanup() {
  if [[ -n "$PREPASS_TMP" ]]; then
    rm -f -- "$PREPASS_TMP"
  fi
}
trap cleanup EXIT

show_usage() {
  echo "Usage: md2html [options] <file.md>"
  echo ""
  echo "Convert a Markdown file into a self-contained, beautifully styled HTML file using pandoc."
  echo ""
  echo "Modes:"
  echo "  md2html <file.md>         Write <file>.html alongside the .md"
  echo "  md2html --open <file.md>  Write <file>.html alongside the .md and open it in the browser"
  echo "  md2html --view <file.md>  Render to a temp file and open it (no local artifact)"
  echo ""
  echo "Options:"
  echo "  -h, --help    Show this help message and exit"
  echo "  --open        Persist the HTML next to the .md and open it in the default browser"
  echo "  --view        Render to a unique temp file and open it; no file is left next to the .md"
  echo ""
  echo "Input handling:"
  echo "  A pipe table (outer pipes, valid delimiter row) that directly follows a text line with"
  echo "  no blank line in between gets one blank line inserted before it, so it renders as a table."
  echo "  Fenced code blocks are left untouched. The source .md file is never modified."
  echo "  GitHub-style lists and blockquotes directly after a text line (no blank line) are recognized."
  echo "  Consequence: a line starting with \"- \" right after prose becomes a list item, not paragraph text."
}

# AI-authored GitHub-style Markdown often puts a pipe table directly after a text
# line without a blank line; pandoc then folds the table into that paragraph.
# normalize_tables prints the input to stdout with exactly one blank line inserted
# before such a table header. The rule is strict and deliberately narrow: outer
# pipes on the header and delimiter, matching column counts, a non-pipe non-blank
# previous line, and no changes inside fenced code blocks. Anything else is passed through
# unchanged. Fence handling is conservative, not an exact model of Pandoc's parser: any line
# that looks like a valid backtick or tilde fence marker (any indentation, 3+ markers, no
# backtick in a backtick info string) protects the lines after it until a closing marker of
# the same character, at least the same length, and indented no more than the opening marker.
# Protected text is never edited, even where
# Pandoc would read the marker as paragraph text; that can leave a real table unfixed. The
# source file is never modified.
normalize_tables() {
  awk '
function indent_of(s,   t) {
  t = s
  sub(/[^ ].*$/, "", t)
  return length(t)
}
function trim(s) {
  sub(/^[ \t]+/, "", s)
  sub(/[ \t]+$/, "", s)
  return s
}
function run_len(s, c,   n) {
  n = 0
  while (substr(s, n + 1, 1) == c) n++
  return n
}
function fence_open(s,   ind, body, ch, n) {
  ind = indent_of(s)
  body = substr(s, ind + 1)
  ch = substr(body, 1, 1)
  if (ch != "`" && ch != "~") return 0
  n = run_len(body, ch)
  if (n < 3) return 0
  if (ch == "`" && index(substr(body, n + 1), "`")) return 0
  FENCE = ch
  FENCE_LEN = n
  FENCE_IND = ind
  return 1
}
function fence_close(s,   ind, body, n) {
  ind = indent_of(s)
  if (ind > FENCE_IND) return 0
  body = substr(s, ind + 1)
  n = run_len(body, FENCE)
  if (n < FENCE_LEN) return 0
  return trim(substr(body, n + 1)) == ""
}

function is_outer_pipe_row(s,   t) {
  if (indent_of(s) > 3) return 0
  t = trim(s)
  return t ~ /^\|.*\|$/
}
function is_delimiter(s,   t) {
  if (!is_outer_pipe_row(s)) return 0
  t = trim(s)
  return t ~ /^\|([ ]*:?-+:?[ ]*\|)+$/
}
function cell_count(s,   t, n) {
  t = trim(s)
  n = gsub(/\|/, "", t)
  return n - 1
}
function needs_gap(i,   prev) {
  prev = L[i - 1]
  if (prev ~ /^[ \t]*$/) return 0
  if (trim(prev) ~ /^\|/) return 0
  if (!is_outer_pipe_row(L[i])) return 0
  if (!is_delimiter(L[i + 1])) return 0
  return cell_count(L[i]) == cell_count(L[i + 1])
}
{ L[NR] = $0 }
END {
  in_fence = 0
  for (i = 1; i <= NR; i++) {
    s = L[i]
    if (in_fence) {
      if (fence_close(s)) in_fence = 0
    } else if (fence_open(s)) {
      in_fence = 1
    } else if (i > 1 && needs_gap(i)) {
      print ""
    }
    print s
  }
}
' "$1"
}

# Parse options
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      show_usage
      exit 0
      ;;
    --open)
      OPEN_IN_BROWSER=true
      shift
      ;;
    --view)
      VIEW_TEMP=true
      shift
      ;;
    -*)
      echo "Error: Unknown option $1" >&2
      show_usage >&2
      exit 1
      ;;
    *)
      if [[ -n "$INPUT_FILE" ]]; then
        echo "Error: Multiple input files specified" >&2
        show_usage >&2
        exit 1
      fi
      INPUT_FILE="$1"
      shift
      ;;
  esac
done

if [[ -z "$INPUT_FILE" ]]; then
  echo "Usage: md2html [options] <file.md>" >&2
  exit 1
fi

if [[ ! -f "$INPUT_FILE" ]]; then
  echo "Error: Input file not found: $INPUT_FILE" >&2
  exit 1
fi

input="$INPUT_FILE"
title="$(basename "$input" .md)"
if [[ "$VIEW_TEMP" == "true" ]]; then
  output="${TMPDIR:-/tmp}/${title}.$$.html"
else
  output="${input%.md}.html"
fi

# Pre-pass: write normalized input to a temp file only if it differs from the source.
PREPASS_TMP="$(mktemp "${TMPDIR:-/tmp}/md2html-input.XXXXXX")"
normalize_tables "$input" > "$PREPASS_TMP"
if cmp -s "$input" "$PREPASS_TMP"; then
  pandoc_input="$input"
else
  pandoc_input="$PREPASS_TMP"
fi

pandoc -f markdown+lists_without_preceding_blankline-blank_before_blockquote -s \
  --metadata colorlinks=true \
  --metadata title="$title" \
  --syntax-highlighting=tango \
  -B <(cat <<'EOF'
<style>
:root {
  color-scheme: light;
}

html, body {
  background: #ffffff !important;
  color: #333333 !important;
}

body {
  max-width: 95% !important;
  margin: auto !important;
  padding: 12px !important;
  font-family: "HelveticaNeue-Light", sans-serif, "宋体", "Segoe WPC", "Segoe UI", "SFUIText-Light", "Droid Sans Fallback" !important;
  font-size: 18px !important;
  line-height: 1.6 !important;
  word-wrap: break-word;
  color: #333333 !important;
}

a {
  color: #4080D0;
  text-decoration: none;
}

a:hover {
  text-decoration: underline;
}

pre {
  background: #f5f5f5;
  border: 1px solid #e0e0e0;
  border-radius: 4px;
  padding: 12px;
  overflow-x: auto;
  font-size: 14px;
  line-height: 1.5;
}

code {
  background: #f5f5f5;
  border-radius: 3px;
  padding: 0.2em 0.4em;
  font-size: 14px;
  font-family: "Courier New", Courier, monospace;
}

:not(pre):not(.hljs) > code {
  color: #6B4F00;
  font-size: inherit;
}

pre code {
  background: transparent;
  padding: 0;
  font-size: inherit;
  color: inherit;
}

h1, h2, h3, h4, h5, h6 {
  margin-top: 1.5em;
  margin-bottom: 0.5em;
  font-weight: 600;
}

h1 { font-size: 2em; border-bottom: 2px solid #4080D0; padding-bottom: 0.3em; }
h2 { font-size: 1.5em; border-bottom: 1px solid #ddd; padding-bottom: 0.3em; }
h3 { font-size: 1.25em; }

blockquote {
  border-left: 4px solid #4080D0;
  margin: 0;
  padding: 0 0 0 12px;
  color: #666;
}

table {
  border-collapse: collapse;
  width: 100%;
  margin: 1em 0;
}

th, td {
  border: 1px solid #ddd;
  padding: 8px 12px;
  text-align: left;
}

th {
  background: #f5f5f5;
  font-weight: 600;
}

tr:nth-child(even) {
  background: #fafafa;
}

hr {
  border: 0;
  border-top: 1px solid #ddd;
  margin: 2em 0;
}

img {
  max-width: 100%;
  height: auto;
}
</style>
EOF
) \
  "$pandoc_input" -o "$output"

  if [[ "$VIEW_TEMP" == "true" ]]; then
    echo "→ $output (temp)"
  else
    echo "→ $output"
  fi
  
if [[ "$OPEN_IN_BROWSER" == "true" || "$VIEW_TEMP" == "true" ]]; then
  if command -v open >/dev/null 2>&1; then
    # MD2HTML_BROWSER: app name to force (e.g. "Google Chrome", "Brave Browser", "Firefox")
    if [[ -n "${MD2HTML_BROWSER:-}" ]]; then
      open -a "$MD2HTML_BROWSER" "$output"
    else
      open "$output"
    fi
  elif command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$output"
  else
    echo "Warning: Could not find 'open' or 'xdg-open' to open the file in browser." >&2
  fi
fi
