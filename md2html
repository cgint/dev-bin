#!/usr/bin/env bash
set -euo pipefail

OPEN_IN_BROWSER=false
VIEW_TEMP=false
INPUT_FILE=""

show_usage() {
  echo "Usage: md2html [options] <file.md>"
  echo ""
  echo "Convert a Markdown file into a self-contained, beautifully styled HTML file using pandoc."
  echo ""
  echo "Modes:"
  echo "  md2html <file.md>         Write <file>.html alongside the .md"
  echo "  md2html --open <file.md>  Write <file>.html alongside the .md and open it in the browser"
  echo "  md2html --view <file.md>  Render to a temp file and open it (no local artifact)"
  echo ""
  echo "Options:"
  echo "  -h, --help    Show this help message and exit"
  echo "  --open        Persist the HTML next to the .md and open it in the default browser"
  echo "  --view        Render to a unique temp file and open it; no file is left next to the .md"
}

# Parse options
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      show_usage
      exit 0
      ;;
    --open)
      OPEN_IN_BROWSER=true
      shift
      ;;
    --view)
      VIEW_TEMP=true
      shift
      ;;
    -*)
      echo "Error: Unknown option $1" >&2
      show_usage >&2
      exit 1
      ;;
    *)
      if [[ -n "$INPUT_FILE" ]]; then
        echo "Error: Multiple input files specified" >&2
        show_usage >&2
        exit 1
      fi
      INPUT_FILE="$1"
      shift
      ;;
  esac
done

if [[ -z "$INPUT_FILE" ]]; then
  echo "Usage: md2html [options] <file.md>" >&2
  exit 1
fi

if [[ ! -f "$INPUT_FILE" ]]; then
  echo "Error: Input file not found: $INPUT_FILE" >&2
  exit 1
fi

input="$INPUT_FILE"
title="$(basename "$input" .md)"
if [[ "$VIEW_TEMP" == "true" ]]; then
  output="${TMPDIR:-/tmp}/${title}.$$.html"
else
  output="${input%.md}.html"
fi

pandoc -s \
  --metadata title="$title" \
  --syntax-highlighting=tango \
  -B <(cat <<'EOF'
<style>
body {
  max-width: 95% !important;
  margin: auto !important;
  padding: 12px !important;
  font-family: "HelveticaNeue-Light", sans-serif, "宋体", "Segoe WPC", "Segoe UI", "SFUIText-Light", "Droid Sans Fallback" !important;
  font-size: 18px !important;
  line-height: 1.6 !important;
  word-wrap: break-word;
  color: #333333 !important;
}

a {
  color: #4080D0;
  text-decoration: none;
}

a:hover {
  text-decoration: underline;
}

pre {
  background: #f5f5f5;
  border: 1px solid #e0e0e0;
  border-radius: 4px;
  padding: 12px;
  overflow-x: auto;
  font-size: 14px;
  line-height: 1.5;
}

code {
  background: #f5f5f5;
  border-radius: 3px;
  padding: 0.2em 0.4em;
  font-size: 14px;
  font-family: "Courier New", Courier, monospace;
}

:not(pre):not(.hljs) > code {
  color: #6B4F00;
  font-size: inherit;
}

pre code {
  background: transparent;
  padding: 0;
  font-size: inherit;
  color: inherit;
}

h1, h2, h3, h4, h5, h6 {
  margin-top: 1.5em;
  margin-bottom: 0.5em;
  font-weight: 600;
}

h1 { font-size: 2em; border-bottom: 2px solid #4080D0; padding-bottom: 0.3em; }
h2 { font-size: 1.5em; border-bottom: 1px solid #ddd; padding-bottom: 0.3em; }
h3 { font-size: 1.25em; }

blockquote {
  border-left: 4px solid #4080D0;
  margin: 0;
  padding: 0 0 0 12px;
  color: #666;
}

table {
  border-collapse: collapse;
  width: 100%;
  margin: 1em 0;
}

th, td {
  border: 1px solid #ddd;
  padding: 8px 12px;
  text-align: left;
}

th {
  background: #f5f5f5;
  font-weight: 600;
}

tr:nth-child(even) {
  background: #fafafa;
}

hr {
  border: 0;
  border-top: 1px solid #ddd;
  margin: 2em 0;
}

img {
  max-width: 100%;
  height: auto;
}
</style>
EOF
) \
  "$input" -o "$output"

  if [[ "$VIEW_TEMP" == "true" ]]; then
    echo "→ $output (temp)"
  else
    echo "→ $output"
  fi
  
if [[ "$OPEN_IN_BROWSER" == "true" || "$VIEW_TEMP" == "true" ]]; then
  if command -v open >/dev/null 2>&1; then
    # MD2HTML_BROWSER: app name to force (e.g. "Google Chrome", "Brave Browser", "Firefox")
    if [[ -n "${MD2HTML_BROWSER:-}" ]]; then
      open -a "$MD2HTML_BROWSER" "$output"
    else
      open "$output"
    fi
  elif command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$output"
  else
    echo "Warning: Could not find 'open' or 'xdg-open' to open the file in browser." >&2
  fi
fi
