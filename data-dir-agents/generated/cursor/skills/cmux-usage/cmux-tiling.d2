direction: down

title: {
  label: "**Building a 2x2 grid in the right half**\nnew-split <dir> --surface S\nsplits only the pane that holds S"
  style.fill: "#e8f0fe"
}

s0: {
  label: "**Step 0**\none pane: S0"
  style.fill: "#f3f7ec"
}

s1: {
  label: "**Step 1** — split right from S0\nS0 | S1"
}

s2: {
  label: "**Step 2** — split down from S1\nS0 | (S1 over S2)"
}

s3: {
  label: "**Step 3** — split right from S1\ntop row becomes S1 | S3"
}

s4: {
  label: "**Step 4** — split right from S2\nbottom row becomes S2 | S4"
}

done: {
  label: "**Result (measured with stty size)**\nS0 = 67x141 full height\nS1 S3 S2 S4 = 32x70 each"
  style.fill: "#f3f7ec"
}

warn: {
  label: "**tree/list-panes show no geometry**\nThey give pane count only.\nMeasure with stty size to confirm.\nA never-displayed workspace\nreports a default size."
  style.fill: "#fdecea"
}

title -> s0
s0 -> s1 -> s2 -> s3 -> s4 -> done
done -> warn: "verify"
