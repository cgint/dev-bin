note: {
  label: "**Both levels look like \"tabs\" to the user.**\nSidebar entries = workspaces (vertical tabs)\nStrip inside a pane = surfaces (horizontal tabs)\nA pane is a split, not a tab."
  style.fill: "#fdecea"
}
